<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.yinwenyuan28-afk</groupId>
        <artifactId>ai-lite-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ai-lite-spring-boot-starter</artifactId>
    <name>AI Lite Spring Boot Starter</name>
    <description>Spring Boot 2.x auto-configuration for the AI Lite gateway, agent loop and session runtime.</description>

    <dependencies>
        <dependency>
            <groupId>io.github.yinwenyuan28-afk</groupId>
            <artifactId>ai-lite-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yinwenyuan28-afk</groupId>
            <artifactId>ai-lite-prompt</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yinwenyuan28-afk</groupId>
            <artifactId>ai-lite-http-okhttp</artifactId>
        </dependency>
        <!-- 可选：用户显式引入后可用 ai-lite.executor.mode=coroutines。 -->
        <dependency>
            <groupId>io.github.yinwenyuan28-afk</groupId>
            <artifactId>ai-lite-executor-coroutines</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.yinwenyuan28-afk</groupId>
            <artifactId>ai-lite-session-jdbc</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 仅在测试里提供可选传输，验证显式选择与 fail-fast。 -->
        <dependency>
            <groupId>io.github.yinwenyuan28-afk</groupId>
            <artifactId>ai-lite-http-jdk8</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.yinwenyuan28-afk</groupId>
            <artifactId>ai-lite-http-jetty</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.yinwenyuan28-afk</groupId>
            <artifactId>ai-lite-http-webclient</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.yinwenyuan28-afk</groupId>
            <artifactId>ai-lite-http-ktor-cio</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
