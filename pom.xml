    <build>
        <!--
            API 兼容性门禁（对外契约冻结计划 Phase 2）。

            japicmp 拿当前构建出的 jar 与上一个已发布版本做签名比对：
            删了 public 方法、改了参数类型、把类降级为包内可见，都会让 verify 失败。
            没有这道门禁，「冻结」只是文档里的一句承诺，一次误删要到用户升级后
            抛 NoSuchMethodError 才会暴露。

            基线用 ai-lite.release.version 固定为上一个发布版，而不是 git tag：
            CI 浅克隆时 tag 不存在，本地也可能没 fetch 全，固定版本号最稳。

            排除规则：
            - *.internal.*  ：内部实现，允许随意改（这正是迁包的目的）
            - 迁移过包的 9 个内部类：它们从公开包移走，本次必然被判为"类已删除"，
              已写进 CHANGELOG 的包名迁移说明；基线版本固定后这条豁免可长期保留，
              因为旧坐标本来就不该被用户依赖。
        -->
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>com.github.siom79.japicmp</groupId>
                    <artifactId>japicmp-maven-plugin</artifactId>
                    <version>0.15.7</version>
                    <configuration>
                        <!--
                            基线制品从 Maven Central 直接拉取。
                            settings.xml 里的 aliyun mirror 对本仓库不生效（mirror 只接管
                            central），因此新增一个独立 id 的仓库，避免"刚发布的版本在镜像
                            上还没同步"导致 verify 假失败——这个坑在 0.1.7 发布当天真的踩到了：
                            ai-lite-core 已同步、ai-lite-prompt 还是 404。
                        -->
                        <oldVersion>
                            <dependency>
                                <groupId>${project.groupId}</groupId>
                                <artifactId>${project.artifactId}</artifactId>
                                <version>${ai-lite.release.version}</version>
                                <type>jar</type>
                            </dependency>
                        </oldVersion>
                        <newVersion>
                            <file>
                                <path>${project.build.directory}/${project.build.finalName}.jar</path>
                            </file>
                        </newVersion>
                        <parameter>
                            <!-- 只报告破坏性变更；新增方法/新增类不算失败。 -->
                            <onlyModified>true</onlyModified>
                            <onlyBinaryIncompatible>true</onlyBinaryIncompatible>
                            <breakBuildOnBinaryIncompatibleModifications>true</breakBuildOnBinaryIncompatibleModifications>
                            <breakBuildOnSourceIncompatibleModifications>false</breakBuildOnSourceIncompatibleModifications>
                            <ignoreMissingClasses>true</ignoreMissingClasses>
                            <includeSynthetic>false</includeSynthetic>
                            <accessModifier>public</accessModifier>
                        </parameter>
                        <packaging>jar</packaging>
                        <skip>false</skip>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.8.1</version>
                    <configuration>
                        <source>${maven.compiler.source}</source>
                        <target>${maven.compiler.target}</target>
                        <encoding>${project.build.sourceEncoding}</encoding>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>2.22.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.1.2</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!--
            API 兼容性门禁（对外契约冻结计划 Phase 2）：mvn verify -Pcontract-check

            默认不激活的原因：SNAPSHOT 开发期的公开 API 本来就在演化，日构建天天红
            没有意义。发布前（Phase 5 翻版本）跑一次，以及 CI 的 release 工作流里跑。
            等 1.0 冻结后，可改为默认激活。
        -->
        <profile>
            <id>contract-check</id>
            <!--
                基线制品直接走 Maven Central，不经 aliyun 镜像。
                settings.xml 的 mirrorOf=central 只接管 id 为 central 的仓库，
                这里用独立 id 绕开它，避免镜像同步延迟把门禁变成假失败。
            -->
            <repositories>
                <repository>
                    <id>maven-central-direct</id>
                    <url>https://repo1.maven.org/maven2</url>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </repository>
            </repositories>
            <pluginRepositories>
                <pluginRepository>
                    <id>maven-central-direct</id>
                    <url>https://repo1.maven.org/maven2</url>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </pluginRepository>
            </pluginRepositories>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.siom79.japicmp</groupId>
                        <artifactId>japicmp-maven-plugin</artifactId>
                        <configuration>
                            <parameter>
                                <onlyModified>true</onlyModified>
                                <onlyBinaryIncompatible>true</onlyBinaryIncompatible>
                                <breakBuildOnBinaryIncompatibleModifications>true</breakBuildOnBinaryIncompatibleModifications>
                                <breakBuildOnSourceIncompatibleModifications>false</breakBuildOnSourceIncompatibleModifications>
                                <ignoreMissingClasses>true</ignoreMissingClasses>
                                <includeSynthetic>false</includeSynthetic>
                                <accessModifier>public</accessModifier>
                                <excludes>
                                    <!-- 内部实现：允许随意变更，这正是迁到 .internal 的目的。 -->
                                    <exclude>io.github.yinwenyuan28.ailite.internal.*</exclude>
                                    <exclude>io.github.yinwenyuan28.ailite.internal.**</exclude>
                                    <!--
                                        迁移过包的内部类（CHANGELOG 有包名迁移说明）。
                                        旧坐标从来不是公开契约，被判定为"类删除"属预期。
                                    -->
                                    <exclude>io.github.yinwenyuan28.ailite.llm.RetrySupport</exclude>
                                    <exclude>io.github.yinwenyuan28.ailite.llm.AsyncLlmCallLogger</exclude>
                                    <exclude>io.github.yinwenyuan28.ailite.llm.SequentialToolExecutor</exclude>
                                    <exclude>io.github.yinwenyuan28.ailite.llm.NoopLlmCallStore</exclude>
                                    <exclude>io.github.yinwenyuan28.ailite.llm.RetryScheduler</exclude>
                                    <exclude>io.github.yinwenyuan28.ailite.session.AgentSessionStoreSupport</exclude>
                                    <exclude>io.github.yinwenyuan28.ailite.http.Utf8LineBuffer</exclude>
                                    <exclude>io.github.yinwenyuan28.ailite.executor.PlatformExecutorProvider</exclude>
                                    <exclude>io.github.yinwenyuan28.ailite.executor.DirectExecutorProvider</exclude>
                                    <!--
                                        A 组 SPI（只允许新增 default 方法）。

                                        japicmp 0.15.7 的 excludes 只支持类级匹配，不支持
                                        `类#方法` 形式；而它把「接口新增方法」一律判为
                                        binaryCompatible=false，不区分是否给了 default 实现。
                                        这与 A 组承诺（只允许新增 default 方法，且 Java 8 下对既有实现类
                                        二进制兼容）冲突。

                                        代价：排除整类后，「删抽象方法」这类真破坏不会被这个插件发现。
                                        替代校验（已在本模块测试中固化）：
                                          1) AgentSessionStore 有 4 个抽象方法，任何实现类都必须实现——
                                             编译期即可发现方法被删；
                                          2) ResumeOptionsTest / SessionUsageAndListingTest
                                             显式断言 supportsListing() 默认 false、
                                             listByUser 默认空、tryAcquireCompaction 默认 true，
                                             覆盖了 default 方法的存在性与语义。

                                        1.0 冻结时若升级到支持方法级 exclude 的 japicmp 版本，
                                        应把这两行换回精确的方法级豁免。
                                    -->
                                    <exclude>io.github.yinwenyuan28.ailite.session.AgentSessionStore</exclude>
                                </excludes>
                            </parameter>
                        </configuration>
                        <executions>
                            <execution>
                                <id>api-compatibility-check</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>cmp</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- JDK 21 才编译虚拟线程模块；JDK 8/17 构建时自动跳过。 -->
        <profile>
            <id>jdk21</id>
            <activation>
                <jdk>[21,)</jdk>
            </activation>
            <modules>
                <module>ai-lite-executor-jdk21</module>
                <module>ai-lite-http-okhttp-jdk21</module>
            </modules>
        </profile>

        <!--
            发布专用 profile（release.yml 的 deploy job 用 -Prelease 激活）：
            附加 sources / javadoc / GPG 签名 / Central Portal 上传。
            Central 凭证与 GPG 密钥的配置方法见 docs/ref-发布.md；
            未配置凭证时日常构建不激活本 profile，零影响。
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.2.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.2.0</version>
                        <configuration>
                            <!-- 注释是中文且面向 JDK 8：关闭 doclint，避免误报阻断发布。 -->
                            <doclint>none</doclint>
                            <charset>UTF-8</charset>
                            <encoding>UTF-8</encoding>
                            <docencoding>UTF-8</docencoding>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>1.6</version>
                        <configuration>
                            <!--
                                CI 无 TTY 必须的两项（gpg 插件 1.6 只有 passphrase /
                                passphraseServerId 两个口令入口，没有 3.x 才有的
                                gpgPassphraseEnvName）。注意：XML 注释里不能出现连续
                                两个减号，故参数名在下方 arg 元素中书写。
                                1) batch 模式：禁止任何交互式提示
                                2) pinentry-mode loopback：口令由参数给定，不弹 pinentry
                                口令本身经 gpg.passphrase 属性传入（见 release.yml）。
                            -->
                            <gpgArguments>
                                <arg>--batch</arg>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <!--
                            0.12.0 修复了 Maven 3.10 下的「Bundle has content that does
                            NOT have a .pom file」：3.10 会把 maven-metadata-local.xml /
                            _remote.repositories 写进 staging 目录，旧版打包前不清理，
                            导致 bundle 缺 pom 被 Central 拒收。
                            0.12.0 仍以 source/target 8 编译（JDK 8 可用），但要求
                            Maven 3.9+：日常构建用本地 3.6.2 没问题，发布由 CI 执行。
                        -->
                        <version>0.12.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <!-- 凭证来自 runner 上生成的 ~/.m2/settings.xml（见 release.yml）。 -->
                            <excludeArtifacts>
                                <artifact>ai-lite-demo</artifact>
                            </excludeArtifacts>
                            <autoPublish>false</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
