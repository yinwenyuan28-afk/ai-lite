        <!-- 编译基线是 Boot 2.1；CI 会用 -Dspring-boot.version=2.7.18 再验证一次。 -->
        <spring-boot.version>2.1.10.RELEASE</spring-boot.version>
        <!--
            4.12.1 是 4.12.x 线的安全补丁（2026-10-22 发布，4.12.0 停留在 2023 年）：
            新增 okhttp3.internal.tls.CertificateBlocklist，屏蔽 8 个已知泄露证书的
            SHA-256。公开方法签名与 4.12.0 完全一致，BridgeInterceptor 仅改
            User-Agent 版本号。仓库已由 square/okhttp 整体转移为 lysine-dev/okhttp
            （同一仓库 ID 与 star 数），该版本与 5.5.1 使用同一 GPG 签名密钥。
        -->
        <okhttp.version>4.12.1</okhttp.version>
        <!-- Boot 2.1 的 BOM 把 kotlin-stdlib 锁在 1.2.x，OkHttp 4.x 需要 1.8+。 -->
        <kotlin.version>1.9.25</kotlin.version>
        <junit.version>4.13.2</junit.version>
        <assertj.version>3.11.1</assertj.version>
        <!-- sqlite-jdbc 3.45 仍支持 JDK 8。 -->
        <sqlite.version>3.45.3.0</sqlite.version>
        <!--
            API 兼容性门禁的对比基线：上一个已发布到 Central 的版本。
            每次正式发布后手工前移这一行（随 release 提交一起改）。
            0.1.8 发布时漏了前移，0.1.9 补上；此后每次发版都要跟着走。

            当前停在 0.1.9：0.1.10 的 bundle 已上传到 Central Portal 但还没手动
            Publish，中央仓库里取不到 0.1.10 的 jar。等 0.1.10 真正发布后再前移，
            否则 -Pcontract-check 会在离线/镜像未同步时假失败。
        -->
        <ai-lite.release.version>0.1.9</ai-lite.release.version>
    </properties>

