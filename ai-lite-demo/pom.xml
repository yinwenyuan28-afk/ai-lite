<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.yinwenyuan28-afk</groupId>
        <artifactId>ai-lite-parent</artifactId>
        <version>0.1.6</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ai-lite-demo</artifactId>
    <name>AI Lite Demo</name>
    <description>Runnable demo for the AI Lite starter.</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yinwenyuan28-afk</groupId>
            <artifactId>ai-lite-spring-boot-starter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
                demo 是示例工程，不发布到 Maven Central —— 但**不要**在这里配
                skipPublishing。central-publishing 插件以聚合模式工作：只在
                reactor 最后一个模块上执行一次 publish goal，从 target/central-staging
                打包含全部模块的 bundle。demo 正好是最后一个模块，跳过它等于跳过
                整批上传（构建仍返回 success，但 Portal 上不会有任何部署记录）。
                排除 demo 自己的制品用父 pom release profile 的 excludeArtifacts。
            -->
        </plugins>
    </build>
</project>
